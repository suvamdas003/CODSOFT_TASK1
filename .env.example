# Copy this file to `.env` and fill in the values marked REQUIRED.
# Never commit `.env` — it is excluded by .gitignore and .dockerignore.

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection used by the app, Prisma CLI and seed script.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# URL-encode special characters in the password (e.g. @ -> %40, # -> %23).
#
# Option B (Docker, `docker compose up -d`): these defaults work unchanged.
DATABASE_URL="postgresql://edumanage:edumanage_dev@localhost:5433/edumanage?schema=public"
# Separate, disposable database for integration tests. The test suite ERASES it.
# Its name must contain "test".
TEST_DATABASE_URL="postgresql://edumanage:edumanage_dev@localhost:5433/edumanage_test?schema=public"
#
# Option A (your own PostgreSQL on port 5432, see README section 5): use instead
# DATABASE_URL="postgresql://edumanage:YOUR_DB_PASSWORD@localhost:5432/edumanage?schema=public"
# TEST_DATABASE_URL="postgresql://edumanage:YOUR_DB_PASSWORD@localhost:5432/edumanage_test?schema=public"

# ── Authentication ────────────────────────────────────────────────────────────
# REQUIRED. Signs session cookies. The app refuses to start with this placeholder or
# with anything shorter than 32 characters. Generate a new value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="replace-with-output-of-the-command-above"

# Exact URL you open the app at (scheme, host and port). Used for cookie/origin checks.
BETTER_AUTH_URL="http://localhost:3000"

# ── Demo data (development only) ──────────────────────────────────────────────
# Password for every synthetic demo account created by `npm run db:seed`: at least
# 8 characters with a letter and a number. The seed refuses to run with NODE_ENV=production.
SEED_DEMO_PASSWORD="choose-a-dev-only-password"

# ── Optional ──────────────────────────────────────────────────────────────────
# Sign-in attempts per client IP per minute (default 5).
# AUTH_SIGNIN_RATE_LIMIT_MAX=5
# Failed sign-ins per account before a 15-minute lock (default 10).
# AUTH_SIGNIN_ACCOUNT_LIMIT_MAX=10
# Extra comma-separated origins allowed to call the auth API.
# BETTER_AUTH_TRUSTED_ORIGINS=
# Comma-separated IPs/CIDRs of your reverse proxies (only when one sits in front of the app).
# BETTER_AUTH_TRUSTED_PROXIES=
# Host port of the Docker development database (default 5433; update both URLs above).
# POSTGRES_PORT=5433
