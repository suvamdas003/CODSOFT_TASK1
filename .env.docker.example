# Configuration for docker-compose.prod.yml (and the optional docker-compose.demo.yml).
# Copy to .env.docker and replace every value. Never commit .env.docker.
#   cp .env.docker.example .env.docker          (PowerShell: Copy-Item .env.docker.example .env.docker)

# REQUIRED. Database password for the bundled PostgreSQL container (letters and digits only).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# It is applied when the database volume is first created; changing it later requires
# changing the password inside PostgreSQL too (see README, Docker troubleshooting).
POSTGRES_PASSWORD=replace-with-generated-hex-password

# REQUIRED. Session signing secret (at least 32 characters; placeholders are rejected).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=replace-with-generated-secret

# The exact URL users open in the browser. Must match, or sign-in is rejected.
# Production cookies are Secure: use https:// for anything other than localhost.
BETTER_AUTH_URL=http://localhost:3000

# Host port the app is published on (keep in sync with BETTER_AUTH_URL).
APP_PORT=3000

# The school's IANA time zone; decides what "today" is for attendance and payments.
TZ=UTC

# Optional: IPs/CIDRs of a reverse proxy in front of the app (e.g. the Docker network
# address of Caddy/nginx), so per-IP sign-in limits use the real client address.
# BETTER_AUTH_TRUSTED_PROXIES=
# Optional: extra comma-separated origins allowed to call the auth API.
# BETTER_AUTH_TRUSTED_ORIGINS=

# Demo stack only (docker-compose.demo.yml): password for every synthetic demo account.
# Ignored by the production stack, which never loads demo data.
# SEED_DEMO_PASSWORD=
