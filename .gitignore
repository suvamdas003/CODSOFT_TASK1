
# ==========================================
# Dependencies
# ==========================================
/node_modules
/.pnp
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==========================================
# Testing and test artifacts
# ==========================================
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/tests/e2e/.auth/

# ==========================================
# Next.js and build output
# ==========================================
/.next/
/out/
/build
/dist

# ==========================================
# Generated Prisma client
# Re-created by npm run db:generate
# ==========================================
/src/generated/

# ==========================================
# Environment files and secrets
# Ignore all environment files by default.
# Allow only safe example templates.
# NEVER commit real secrets or credentials.
# ==========================================
.env
.env.*
!.env.example
!.env.docker.example

# Other common secret and credential files
*.pem
*.key
*.p12
*.pfx
*.secret
secrets/
.secrets/

# ==========================================
# Logs
# ==========================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==========================================
# Local databases, dumps, and backups
# ==========================================
*.sqlite
*.db
*.dump
*.sql.gz
*.bak
/pgdata/
/backups/
/backup*.sql

# Ignore SQL dumps anywhere in the project
# If you intentionally need migration SQL files, they remain tracked
# because this rule applies only to compressed dumps above.

# ==========================================
# Docker local overrides and environment files
# ==========================================
.env.docker.local
docker-compose.override.yml
docker-compose.*.override.yml

# ==========================================
# OS and editor files
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/

# ==========================================
# Deployment and build metadata
# ==========================================
.vercel
*.tsbuildinfo
next-env.d.ts

# ==========================================
# Local Python environments and caches
# ==========================================
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

