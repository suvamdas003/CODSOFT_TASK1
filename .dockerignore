# Version control and local tooling
.git
.gitignore
.vscode
.idea
.claude

# Dependencies and build output (rebuilt inside the image)
node_modules
.next
out
build
dist
src/generated
*.tsbuildinfo
next-env.d.ts

# Test artifacts
coverage
test-results
playwright-report
blob-report
playwright/.cache
tests/e2e/.auth

# Docker definitions (not needed inside the image)
Dockerfile
.dockerignore
docker-compose*.yml

# Never copy local secrets, keys or database data into an image.
**/.env
**/.env.*
!.env.example
!.env.docker.example
*.pem
*.key
*.log

# Database dumps and local data
backups
pgdata
*.dump
*.sql.gz
*.sqlite
*.db
